# Control plane database (auth, companies registry, devices)
CONTROL_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/madix_control
PG_HOST=localhost
PG_PORT=5432

JWT_SECRET=change-me-in-production
PORT=4000

# Company SQL snapshots (pg_dump). Default: ./snapshots/{company-name}/
# SNAPSHOT_DIR=/var/lib/madix/snapshots
# Local hour (0-23) for nightly scheduled snapshots; keeps last 7 scheduled files per company
# SNAPSHOT_CRON_HOUR=2
# PostgreSQL client (pg_dump/psql) is downloaded into backend/vendor/pg (gitignored).
# Source: https://github.com/theseus-rs/postgresql-binaries/releases
# Run: npm run ensure-pg-dump
# PG_CLIENT_VERSION=16.10.0
