{
  "name": "madix-e-pos-backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "prebuild": "cd ../packages && npm i",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc",
    "ensure-pg-dump": "node scripts/ensure-pg-dump.js",
    "postinstall": "node scripts/ensure-pg-dump.js || true",
    "migrate": "npx knex migrate:latest --knexfile knexfile.ts",
    "migrate:control": "npx knex migrate:latest --knexfile knexfile.ts",
    "migrate:rollback": "npx knex migrate:rollback --knexfile knexfile.ts"
  },
  "dependencies": {
    "@madix/database": "file:../packages",
    "@madix/sync": "file:../sync-system",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "knex": "^3.1.0",
    "pg": "^8.12.0",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.8",
    "tsx": "^4.16.2",
    "typescript": "^5.5.2"
  }
}
